// Los modelos reflejan tablas, columnas, relaciones, enums e indices (incluidos los
// parciales y los trigram GIN) de los schemas api y auth. Se generan con `prisma db pull`
// y se ajustan a mano si hace falta.
//
// Lo que Prisma no modela se mantiene como SQL manual en prisma/migrations:
// check constraints, indices unicos por expresion (uq_senales_codigo_lsm,
// uq_equipos_tipo_inventario, uq_modelos_equipo_tipo_nombre), columnas interval (quedan como Unsupported), funciones
// (get_dashboard_stats, get_fault_analytics, get_status_by_zone, log_changes,
// prevent_delete_if_referenced, set_audit_fields), triggers, vistas
// (v_alistamiento_buques, v_equipos, v_libros, v_senales_estadisticas), grants,
// reglas de soft delete y el rol api_service.
//
// El bloque generator existe solo para habilitar previewFeatures = ["partialIndexes"].
// No se usa @prisma/client ni se ejecuta `prisma generate`.
//
// Flujo: editar este archivo -> `prisma migrate dev --create-only` -> completar el SQL manual.
// La URL de la base viene de prisma.config.ts (DATABASE_URL), no va aqui.

generator client {
  provider        = "prisma-client"
  output          = "../generated"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["api", "auth"]
}

