model alistamiento_buques {
  id_alistamiento      String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_buque             String              @db.Uuid
  ano                  Int
  mes                  Int                 @db.SmallInt
  id_tipo_alistamiento String?             @db.Uuid
  descripcion          String?
  observaciones        String?
  fecha_fs             DateTime?           @db.Date
  fecha_alistamiento   DateTime?           @db.Date
  dias_mision_mes      Int?
  dias_fs_mes          Int?
  created_at           DateTime?           @default(now()) @db.Timestamptz(6)
  created_by           String?
  updated_at           DateTime?           @default(now()) @db.Timestamptz(6)
  updated_by           String?
  deleted_at           DateTime?           @db.Timestamptz(6)
  deleted_by           String?
  buques               buques              @relation(fields: [id_buque], references: [id_buque], onDelete: NoAction, onUpdate: NoAction)
  tipos_alistamiento   tipos_alistamiento? @relation(fields: [id_tipo_alistamiento], references: [id_tipo_alistamiento], onDelete: NoAction, onUpdate: NoAction)

  @@unique([id_buque, ano, mes], map: "uq_alistamiento_buques_buque_ano_mes", where: raw("(deleted_at IS NULL)"))
  @@index([id_tipo_alistamiento], map: "idx_alistamiento_buques_id_tipo_alistamiento")
  @@schema("api")
}

