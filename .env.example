PORT=8080
POSTGREST_URL=http://localhost:3000

# PostgREST → PostgreSQL (sobrescribe db-uri de postgrest-docker.conf). Por defecto en compose: servicio "db".
# Si ves "could not translate host name \"db\"", o bien levanta todo con `docker compose up`, o apunta al host real:
# POSTGREST_DB_URI=postgres://postgres:admin@127.0.0.1:5432/infoanav
# POSTGREST_DB_URI=postgres://postgres:admin@db:5432/infoanav
#
# Tras pg_restore/psql contra Postgres local: npm run db:post-restore:local (parche SQL + JWT desde postgrest.conf)
