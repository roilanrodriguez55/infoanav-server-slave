# Base del gateway. Relativa (/api) usa el proxy de Vite en desarrollo o el proxy inverso en produccion. Absoluta (https://api.ejemplo.com/api) para dominios separados (requiere CORS_ORIGIN en el servidor).
VITE_API_URL=/api

# Compose (solo desarrollo y demos)
# Ruta al docker-compose.yml del servidor. En un worktree apuntar a su ruta absoluta.
# SERVER_COMPOSE=../infoanav-server-slave/docker-compose.yml
# Puerto host del frontend (nginx), por defecto 8081
# WEB_HOST_PORT=8081
