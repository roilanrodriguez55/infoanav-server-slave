# Copia este archivo a .env y ajusta los valores. No subas .env al repositorio.

# Cadena de conexion a PostgreSQL usada por Prisma (migraciones) y por el servidor.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/infoanav
# Puerto HTTP del servidor gateway.
PORT=8080
# Entorno de ejecucion (development o production).
NODE_ENV=development
# Secreto para firmar los JWT de acceso. Minimo 32 caracteres.
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-de-minimo-32-caracteres
# Duracion del token de acceso (formato de jsonwebtoken, p. ej. 15m).
ACCESS_TOKEN_TTL=15m
# Dias de vigencia del refresh token.
REFRESH_TOKEN_TTL_DAYS=7
# Marca la cookie de refresh como Secure. Usar true solo con HTTPS.
COOKIE_SECURE=false
# Origenes permitidos para CORS, separados por comas. Vacio = sin CORS.
CORS_ORIGIN=
# URL interna donde escucha PostgREST.
POSTGREST_URL=http://127.0.0.1:3000
# Secreto con el que PostgREST valida los JWT. Minimo 32 caracteres.
POSTGREST_JWT_SECRET=cambia-esto-por-otro-secreto-largo-de-minimo-32-caracteres
# true para que el servidor lance PostgREST como proceso hijo.
START_POSTGREST=true
# Ruta al binario de PostgREST cuando START_POSTGREST=true.
POSTGREST_BIN=./bin/postgrest
# true para exponer la documentacion Swagger en /api-docs.
ENABLE_DOCS=false
# Numero de proxies de confianza delante del servidor (1 detras de nginx). Necesario para que el limite de intentos use la IP real.
TRUST_PROXY=0
# Puerto del host para PostgreSQL en docker-compose (solo desarrollo/demos).
# DB_HOST_PORT=5437
# Puerto del host para el gateway en docker-compose (solo desarrollo/demos).
# API_HOST_PORT=8080
