# Copia opcional a .env para sustitución en docker-compose.yml
# Si 8080 está ocupado (p. ej. npm start), cambia APP_HOST_PORT

APP_HOST_PORT=8081
DB_HOST_PORT=5437
POSTGREST_HOST_PORT=3000

PORT=8080
POSTGREST_URL=http://postgrest:3000

# auto = restaurar solo si schema api vacío | force = siempre | skip = no restaurar
RESTORE_BACKUP=auto
SETUP_DATABASE_ROLES=auto
DB_EXPECTATIONS_PROFILE=afterEntrypointAlways
